# Copy to `.env` and adjust. Never commit `.env` — it is gitignored.

# Upstream IOsense connector. The Vite dev server proxies /api here.
IOSENSE_CONNECTOR_URL=https://connector.iosense.io

# Leave empty in dev so requests go to /api and through the proxy above.
# In production set it to the connector origin if the app is not served behind
# a reverse proxy that already forwards /api.
VITE_IOSENSE_API_BASE=

# Timezone used to render every timestamp (lab sample times and process times alike).
VITE_DISPLAY_TIMEZONE=Asia/Kolkata

# Tolerance in minutes for pairing a predicted C3S value with a laboratory result
# (the line's predictedC3S / actualC3S roles, e.g. ADANI_LAB:D55 / D58, JSW_C3S:D7 /
# FLSCLINKER:D18). Predictions arrive every 15 min, lab results roughly every 2 h.
VITE_C3S_MATCH_TOLERANCE_MIN=15

# Plants, lines, devices, sensors, roles, insight IDs, limits and per-plant settings live in
# src/config/clients/<plant>.ts (not in this file). The two settings below override every
# plant's own value when set; leave them unset to use each plant's spec.

# Latest moment the dashboard loads data for, plant wall-clock time (VITE_DISPLAY_TIMEZONE),
# e.g. 2026-08-28T03:00, or "none". Unset: each plant's own cut-off (Adani 2026-08-28T03:00,
# JSW none).
#VITE_DATA_END=

# SHC Optimizer, opened from an RCA recommendation that calls for SHC optimisation. Unset: each
# plant's own (PlantSpec.shcOptimizerUrl); a plant with none shows "not configured".
#VITE_SHC_OPTIMIZER_URL=

# NOTE ON CREDENTIALS
# This API has no username/password route. The platform issues a single-use SSO
# token, exchanged at GET /api/retrieve-sso-token/:token for the session JWT.
# Open the app as  http://localhost:5173/?token=<sso-token>  and it exchanges and
# stores the JWT automatically, or paste a session token into the sign-in screen.
# No credential is read from this file at runtime.
